{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm --prefix frontend ci",
      "buildCommand": "npm --prefix frontend run build",
      "outputDirectory": "frontend/dist"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
