# AhorrAR scraper env (optional)

SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=4100

# MercadoLibre official API (PRIMARY for ML — see docs/ML.md)
# Without MELI_ACCESS_TOKEN, ML is skipped (no HTML scrape).
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_APP_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_SITE_ID=MLA
