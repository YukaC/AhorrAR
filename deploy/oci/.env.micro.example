# Copy to deploy/oci/.env on the Micro VM (never commit .env).
# cp .env.micro.example .env && chmod 600 .env
#
# Slim profile (~1 GB VM + swap). Knobs aligned with render.yaml (512 MB Free).

# --- Public HTTPS hostname (Caddy + sslip.io) ---
# After reserved/public IP: DOMAIN=<PUBLIC_IP>.sslip.io
DOMAIN=
# Docker Caddy profile: upstream to the api service on the compose network
API_UPSTREAM=api:4000

# --- HTTP / process ---
PORT=4000
HOST=0.0.0.0
CRAWLER=scrapling
SCRAPLING_URL=http://127.0.0.1:4100
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=4100
STEALTH_FETCH=0

# --- CORS (Vercel prod + local dev) ---
CORS_ORIGINS=https://ahorrarg.vercel.app,http://localhost:5173

# --- Crawl / memory (Render-like ceiling) ---
INCLUDE_ML=1
WARM_CACHE=0
MAX_DEPTH=2
MAX_NODES=80
MAX_RESULTS=50
CONCURRENCY=1
ML_MAX_WORKERS=3
FETCH_WORKERS=2
FETCH_LIMIT_HUB=1
FETCH_LIMIT_API=3
FETCH_LIMIT_HTML=1
CRAWL_BATCH_SIZE=3
PROBE_WORKERS=2
FETCH_MAX_BYTES=2000000
CRAWL_DEADLINE_S=30
OFFER_CACHE_MAX_HOSTS=24
OFFER_CACHE_MAX_OFFERS=12
SITEMAP_MAX_HOSTS=3
SITEMAP_MAX_URLS=4
CACHE_MAX_ENTRIES=32
UVICORN_LIMIT_CONCURRENCY=4
NODE_OPTIONS=--max-old-space-size=192
MALLOC_ARENA_MAX=2
PYTHONUNBUFFERED=1

# --- Durable ML OAuth refresh (Docker volume meli_data → /data) ---
MELI_TOKEN_FILE=/data/meli_tokens.json
MELI_SITE_ID=MLA

# --- Mercado Libre OAuth (required when INCLUDE_ML=1) ---
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_APP_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

# --- Optional ---
# STEALTH_PROXY=
# ML_CIRCUIT_FAILURES=3
# ML_CIRCUIT_COOLDOWN_S=300
# LOG_LEVEL=info
