# Copy to deploy/oci/.env on the VM (never commit .env).
# cp .env.example .env && chmod 600 .env

# --- Public HTTPS hostname (Caddy + sslip.io; no paid domain required) ---
# After the VM public IP is assigned: DOMAIN=<PUBLIC_IP>.sslip.io
# Open Security List ingress 80 and 443. Then Vercel: VITE_API_BASE=https://$DOMAIN, VITE_FREE_HOST=0
DOMAIN=YOUR_PUBLIC_IP.sslip.io
# Caddy on the host (not Docker): upstream to loopback-published API
API_UPSTREAM=127.0.0.1:4000

# --- HTTP / process ---
PORT=4000
HOST=0.0.0.0
CRAWLER=scrapling
SCRAPLING_URL=http://127.0.0.1:4100
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=4100

# --- CORS (Vercel prod + local dev) ---
CORS_ORIGINS=https://ahorrarg.vercel.app,http://localhost:5173

# --- OCI full profile (6 GB VM; not Render 512 MB) ---
INCLUDE_ML=1
WARM_CACHE=1
MAX_DEPTH=2
MAX_NODES=120
MAX_RESULTS=100
CONCURRENCY=2
FETCH_WORKERS=4
ML_MAX_WORKERS=6
FETCH_LIMIT_HUB=2
FETCH_LIMIT_API=6
FETCH_LIMIT_HTML=2
CRAWL_BATCH_SIZE=6
PROBE_WORKERS=4
UVICORN_LIMIT_CONCURRENCY=2
CACHE_MAX_ENTRIES=128
CACHE_TTL_MS=900000
OFFER_CACHE_MAX_HOSTS=64
OFFER_CACHE_MAX_OFFERS=30
SITEMAP_MAX_HOSTS=5
SITEMAP_MAX_URLS=8
NODE_OPTIONS=--max-old-space-size=768
MALLOC_ARENA_MAX=2
PYTHONUNBUFFERED=1

# --- Durable ML OAuth refresh (Docker volume meli_data → /data) ---
MELI_TOKEN_FILE=/data/meli_tokens.json
MELI_SITE_ID=MLA
# Optional: persist search jobs across container restarts (same volume)
# JOBS_DB=/data/jobs.sqlite

# --- Mercado Libre OAuth (required when INCLUDE_ML=1) ---
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_APP_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

# --- Optional ---
# STEALTH_FETCH=0
# STEALTH_PROXY=
# ML_CIRCUIT_FAILURES=3
# ML_CIRCUIT_COOLDOWN_S=300
# LOG_LEVEL=info
