#!/usr/bin/env bash
# Canonical project check: typecheck + lint + one test step per workspace.
# Every step reports separately in the OK/FALLA/SALTADO summary; exit != 0 if any FALLA.
# A workspace without a test script is skipped and reported as SALTADO, not silently ignored.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

WORKSPACES=(backend frontend)
RESULTS=()
FAILED=0

record() { # step status [detail]
  RESULTS+=("$1: $2${3:+ ($3)}")
  [ "$2" = "FALLA" ] && FAILED=1
  return 0
}

has_script() { # package-json script-name
  python3 - "$1" "$2" <<'PY'
import json, sys
path, name = sys.argv[1], sys.argv[2]
try:
    scripts = (json.load(open(path, encoding="utf-8")) or {}).get("scripts") or {}
except OSError:
    sys.exit(1)
sys.exit(0 if name in scripts else 1)
PY
}

run_root_step() { # script-name
  local name="$1"
  if [ ! -f package.json ]; then
    record "$name" SALTADO "sin package.json"
    return 0
  fi
  if ! has_script package.json "$name"; then
    record "$name" SALTADO "sin script de $name"
    return 0
  fi
  echo "check: npm run $name"
  if npm run --silent "$name"; then record "$name" OK; else record "$name" FALLA; fi
}

run_workspace_tests() { # workspace
  local ws="$1"
  if [ ! -f "$ws/package.json" ]; then
    record "test-$ws" SALTADO "workspace inexistente"
    return 0
  fi
  if ! has_script "$ws/package.json" test; then
    record "test-$ws" SALTADO "sin script de test"
    return 0
  fi
  echo "check: npm --prefix $ws run test"
  if npm --prefix "$ws" run --silent test; then
    record "test-$ws" OK
  else
    record "test-$ws" FALLA
  fi
}

run_root_step typecheck
run_root_step lint
for ws in "${WORKSPACES[@]}"; do
  run_workspace_tests "$ws"
done

echo "=== check summary ($ROOT) ==="
for line in "${RESULTS[@]}"; do
  echo "$line"
done
exit "$FAILED"